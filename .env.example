# KiGo backend base URL. HTTP auto-redirects to HTTPS, so point at https.
VITE_API_BASE=https://api.kigo.uz

# Google Maps JavaScript API kaliti (console.cloud.google.com → Maps JavaScript API
# + Geocoding API, billing yoqilgan boʻlishi kerak).
# Boʻsh boʻlsa klub qoʻshish modalidagi xarita bepul OpenStreetMap rejimiga oʻtadi.
VITE_GOOGLE_MAPS_KEY=
